# Entorno: development | staging | production
ENTORNO=development

# Base de datos (async driver)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/pos_db

# JWT
# En staging/production JWT_SECRET NO puede quedar en "supersecret" (el arranque falla).
JWT_SECRET=supersecret
JWT_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Semilla del administrador inicial (requerido la primera vez que corre el seeder)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CambiarEsteValor123
SEED_ADMIN_NOMBRE=Administrador

# Rate limiting del login
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# Almacenamiento de imágenes (filesystem local, servido por la propia API).
# MEDIA_BASE_URL debe ser ABSOLUTA (con esquema y host) si el frontend corre
# en otro origen (ver CORS_ORIGINS): el navegador resuelve una ruta relativa
# contra el origen del frontend, no contra el de la API.
MEDIA_ROOT=media
MEDIA_BASE_URL=http://localhost:8000/media
IMAGEN_MAX_BYTES=5242880
